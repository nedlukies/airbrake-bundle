{
    "name": "nedlukies/airbrake-bundle",
    "description": "Airbrake API v3 integration for Symfony 6/7",
    "license": "MIT",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Anton Minin",
            "email": "anton.a.minin@gmail.com"
        },
        {
            "name": "Ned Lukies",
            "email": "ned@madforit.com.au"
        }
    ],
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.0|^7.0",
        "symfony/yaml": "^6.0|^7.0",
        "airbrake/phpbrake": "^1.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.0.2"
    },
    "autoload": {
        "psr-4": {
            "Ami\\AirbrakeBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ami\\AirbrakeBundle\\Tests\\": "Tests"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
